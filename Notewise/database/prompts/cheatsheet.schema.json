{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Notewise Cheatsheet Schema",
  "description": "Schema for exam-focused cheatsheet generated from lecture transcripts",
  "type": "object",
  "required": ["sections"],
  "additionalProperties": false,
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "bullets"],
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 2,
            "maxLength": 150
          },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    }
  }
}
