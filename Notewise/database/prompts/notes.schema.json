{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Notewise Structured Notes Schema",
  "description": "Schema for structured comprehensive lecture notes",
  "type": "object",
  "required": ["key_points", "definitions", "examples", "quick_revision_sheet"],
  "additionalProperties": false,
  "properties": {
    "key_points": {
      "type": "array",
      "items": { "type": "string" }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "definition"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string" },
          "definition": { "type": "string" }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quick_revision_sheet": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
