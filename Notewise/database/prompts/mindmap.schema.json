{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Notewise Mindmap Schema",
  "description": "Recursive hierarchical tree schema for lecture concept visualization",
  "type": "object",
  "required": ["title", "children"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#"
      }
    }
  }
}
